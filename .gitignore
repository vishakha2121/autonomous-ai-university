# API Keys (Gemini, etc.)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# 3. DATABASE (SQLite)
# ==========================================
# Database files (local testing ke liye)
*.db
*.sqlite
*.sqlite3
db.sqlite3

# ==========================================
# 4. NODE / FRONTEND (React, Vite)
# ==========================================
node_modules/
/dist
/dist-ssr
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
