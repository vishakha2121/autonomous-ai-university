                  │
                  ▼
      [ FastAPI CycleOrchestrator ]
                  │
        ┌─────────┴─────────┐
        ▼                   ▼
 [ ProfessorAgent ]   [ StudentAgent ]
        │                   │
        └─────────┬─────────┘
                  ▼
         [ EvaluatorAgent ]
                  │
                  ▼
      [ PaperService & CurriculumService ]
                  │
                  ▼
          [ SQLite Database ]
                  │
                  ▼
        [ UI Updates via Axios ]
